{
  "name": "tinvar/skeleton",
  "description": "A new Tinvar application: composer create-project tinvar/skeleton my-app",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "ext-pdo_sqlite": "*",
    "ext-sockets": "*",
    "tinvar/database": "0.4.*",
    "tinvar/framework": "0.4.*",
    "tinvar/support": "0.4.*"
  },
  "require-dev": {
    "tinvar/codegen": "0.4.*",
    "tinvar/testing": "0.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-create-project-cmd": [
      "@php tinvar setup"
    ],
    "check": "@php tinvar check",
    "test": [
      "@php tinvar codegen --check",
      "@php tinvar check",
      "@php vendor/bin/pest"
    ]
  }
}
