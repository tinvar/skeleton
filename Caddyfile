# The app under FrankenPHP in worker mode.
#
# Started by `php tinvar serve`, which sets the variables read
# here: where to listen (TINVAR_HOST, TINVAR_PORT), where the app is
# (TINVAR_APP_ROOT) and its build (TINVAR_BUILD_DIR), how many workers to run
# (TINVAR_WORKERS), and the renderers' socket (TINVAR_SOCKET, read by the
# workers from the environment). APP_STORAGE, from the environment it is
# started in, is where the app keeps uploaded files on local disk, if it does.
{
	# Nothing to administer at runtime, nothing to persist between runs, and
	# plain HTTP on loopback: browsers treat http://127.0.0.1 as secure, so
	# the __Host- cookies work without TLS. Put TLS in front for anything else.
	admin off
	persist_config off
	auto_https off

	# A write to a client may stall for 8 s, not Caddy's default minute,
	# before the connection is cut off: FrankenPHP's static binary holds one
	# mutex around every write PHP makes, so one client that stops reading
	# would hold every other response behind it for as long as its write was
	# let stall (ADR 0051 in the framework's repository). The workers no
	# longer write to clients (the `intercept` block below), so this bounds
	# how long a slow client holds Caddy's copy of a response, and the writes
	# still a worker's: a body over a megabyte, or a stream of no known length.
	#
	# And a request is read within deadlines: its headers in 10 s, the whole
	# of it, body and all, in 60 s. FrankenPHP hands a request to a worker
	# before its body has arrived, so a client that sends one slowly holds
	# that worker for as long as it is let; as many as there are workers,
	# and no one else is served (ADR 0207 in the framework's repository).
	# A file larger than a slow line sends in a minute goes in resumable
	# chunks. `php tinvar check` refuses a Caddyfile without all three.
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write_idle 8s
		}

		# The proxies in front -- the TLS terminator, the load balancer --
		# pinned in TINVAR_TRUSTED_PROXIES, which `tinvar serve` hands over
		# space-separated. From one of them, the client is the right-most
		# X-Forwarded-For hop that is not one of them, as PHP reads it for
		# its throttles (Tinvar\Http\TrustedProxies, ADR 0134): so Caddy logs
		# that client, and forwards it to a proxied upstream, rather than the
		# terminator or whatever a client wrote. None pinned, and the peer is
		# the client.
		trusted_proxies static {$TINVAR_TRUSTED_PROXY_RANGES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}

	frankenphp {
		worker {
			file {$TINVAR_APP_ROOT}/public/worker.php
			num {$TINVAR_WORKERS:4}
		}
	}
}

# Any Host header, on the one address asked for: a site address of 127.0.0.1
# alone would listen on every interface and answer only requests naming it.
http://:{$TINVAR_PORT:8080} {
	bind {$TINVAR_HOST:127.0.0.1}

	# No body larger than the largest upload the framework takes
	# (Tinvar\Uploads\Uploads::DEFAULT_MAX_BYTES) and its form around it.
	# PHP refuses a raw body over 8 MiB itself (Sapi::MAX_BODY_BYTES), by
	# its Content-Length before reading it (ADR 0207). Raise both together
	# if the app takes larger files through PHP.
	request_body {
		max_size 11MiB
	}

	# On every response that sets none of its own -- `/_file` sends
	# `no-referrer`, and that stands: no type sniffed from a body, no
	# path or query sent to another origin, and HTTPS remembered for a
	# year once a browser has reached the app over it (a browser ignores
	# HSTS sent over plain HTTP, as on loopback). One directive each: `?`
	# in one block of several skips them all once any one is set.
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?Strict-Transport-Security "max-age=31536000"

	# Built assets: hashed names, so a file at a name never changes and can be
	# cached for a year. Only a name a build writes under /assets/, as PHP
	# serves them -- nothing else under dist/client is meant to be served, and
	# `tinvar check` holds the pattern to PHP's (ADR 0108). Unset -- started by
	# anything but `tinvar serve` -- is nowhere, and every asset a 404, rather
	# than a directory under the root.
	@assets path_regexp "^/assets/[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}-[A-Za-z0-9_-]{8,32}\.(js|css|woff2|woff|png|jpg|webp|avif|gif|svg|wasm)$"
	handle @assets {
		root * {$TINVAR_BUILD_DIR:/nonexistent/tinvar-build}/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app. Rewritten to the worker script so no other
	# file in public/ is ever run; the worker still sees the URI the browser
	# asked for.
	handle {
		root * {$TINVAR_APP_ROOT}/public
		rewrite * /worker.php

		# None of the headers below is for the client.
		header {
			-X-Powered-By
			-X-Accel-Buffering
			-X-Accel-Redirect
		}

		# No worker writes to a client (ADR 0081 in the framework's
		# repository). Every write PHP makes goes through one mutex in the
		# static binary, so a write blocked on a client that stopped reading
		# would hold every other worker's response until `write_idle` cut it
		# off. Here a response is held whole, in memory, while the worker
		# writes it, and Caddy sends it once the worker is done, outside the
		# mutex. `php tinvar check` refuses a Caddyfile without this block.
		#
		# Not every response: Tinvar\Http\Sapi marks one to pass on as it
		# comes -- larger than a megabyte, or streamed with no length -- with
		# `X-Accel-Buffering: no`. And a stored file goes out with no body
		# from PHP at all: `X-Accel-Redirect` names it below APP_STORAGE, the
		# directory the app keeps uploaded files in on local disk, and the
		# file server sends it. Unset, PHP sends files itself, and the root
		# here is nowhere.
		intercept {
			@file header X-Accel-Redirect *
			handle_response @file {
				root * {$APP_STORAGE:/nonexistent/tinvar-storage}
				rewrite * {http.intercept.header.X-Accel-Redirect}
				file_server
			}

			@whole header !X-Accel-Buffering
			handle_response @whole {
				# Nothing to do but send what was held: a route that writes
				# nothing leaves the response as PHP made it.
				vars tinvar_held_whole true
			}
		}

		php {
			env TINVAR_FILE_ROOT "{$APP_STORAGE}"
		}
	}
}
