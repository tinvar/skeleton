#!/usr/bin/env bash
#
# What the image's build stage needs on top of the php:8.5-cli image the
# Dockerfile pins by digest: the PHP extensions the app requires, Composer
# and Node. The framework's CI sets itself up the same way, at the same
# versions and sums (.github/ci/setup in its repository).
#
# Nothing here is fetched by a name that can move. Debian's packages come
# through apt, which checks the archive's signature; Composer and Node are
# each one exact version, and each download is held to the sha256 written
# below before it is used. To move one, change its version and its sum
# together, taking the sum from the project's own published list
# (getcomposer.org's composer.phar.sha256sum, nodejs.org's SHASUMS256.txt).

set -euo pipefail

COMPOSER_VERSION=2.11.1
COMPOSER_SHA256=6f1b891e1d4927d62740276c540fb490e47689e19e102c49e8da849794882f8c

# The 22 line, which package.json's engines field asks for (>=22.13).
NODE_VERSION=22.23.4
case "$(uname -m)" in
    x86_64)
        NODE_ARCH=x64
        NODE_SHA256=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
        ;;
    aarch64)
        NODE_ARCH=arm64
        NODE_SHA256=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
        ;;
    *)
        echo "No Node build is pinned for $(uname -m)." >&2
        exit 1
        ;;
esac

# Download $1 to $2, and refuse it unless its sha256 is $3.
fetch() {
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$2" "$1"
    echo "$3  $2" | sha256sum --check --strict --quiet -
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
# git and unzip for Composer; xz for Node's tarball; libpq for pdo_pgsql.
apt-get install -y -qq --no-install-recommends ca-certificates curl git unzip xz-utils libpq-dev >/dev/null

# pdo_sqlite and posix are built into the image; these are not. The two
# server databases' drivers too, so an app made with --database=postgres or
# mysql migrates and runs its queue from this image's CLI, as FrankenPHP's
# static binary, which has every driver, serves it.
docker-php-ext-install -j"$(nproc)" pcntl sockets pdo_pgsql pdo_mysql >/dev/null

fetch "https://getcomposer.org/download/${COMPOSER_VERSION}/composer.phar" "$work/composer.phar" "$COMPOSER_SHA256"
install -m 0755 "$work/composer.phar" /usr/local/bin/composer

node="node-v${NODE_VERSION}-linux-${NODE_ARCH}"
fetch "https://nodejs.org/dist/v${NODE_VERSION}/${node}.tar.xz" "$work/node.tar.xz" "$NODE_SHA256"
tar -xJf "$work/node.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
    "${node}/bin" "${node}/include" "${node}/lib" "${node}/share"

for extension in pcntl pdo_mysql pdo_pgsql pdo_sqlite posix sockets; do
    # shellcheck disable=SC2016 # $argv is PHP's, not the shell's
    if ! php -r 'exit(extension_loaded($argv[1]) ? 0 : 1);' "$extension"; then
        echo "PHP has no $extension extension." >&2
        exit 1
    fi
done
