#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The app's command line: the framework's commands, pointed at this app.
 *
 *   bin/tinvar help
 *
 * Tinvar\Console\AppConsole owns the commands every app has -- serve, dev,
 * the builds, the migrations, the generators, codegen and the check --
 * handed this app's Kernel, the classes it discovers and its directories. Add your own
 * the same way: `->command('name', 'usage', 'what it does', fn (array $arguments): int => ...)`.
 */

require __DIR__ . '/../vendor/autoload.php';

use App\Kernel;
use Tinvar\Config\ConfigException;
use Tinvar\Config\EnvironmentFile;
use Tinvar\Orm\Connection;
use Tinvar\Orm\Migrations\MigrationRefused;
use Tinvar\Codegen\CodegenCommand;
use Tinvar\Codegen\OpenApi\OpenApiCommand;
use Tinvar\Console\AppConsole;
use Tinvar\Http\ContentSecurityPolicyRules;
use Tinvar\Packages\SupplyChain;
use Tinvar\Render\FragmentManifestProducer;
use Tinvar\Routing\RouteRegistry;
use Tinvar\Server\AssetRouteRules;
use Tinvar\Testing\ResourceTestSource;

/** The app's root: where composer.json, package.json and their lockfiles are. */
const APP_ROOT = __DIR__ . '/..';

// .env, on a developer's machine, before anything reads config: what
// `tinvar new` wrote -- the database, mail, the hosts -- for this CLI and
// everything it starts, serve's workers and dev's included. Never on a
// server, never over what the environment already says, and never a secret
// (EnvironmentFile): a key goes in a file outside the project, named in its
// _FILE variable.
try {
    EnvironmentFile::load(APP_ROOT . '/.env');
} catch (ConfigException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$console = new AppConsole(
    root: APP_ROOT,
    console: __FILE__,
    namespace: 'App',
    // Every class the app registers, discovered under App\ (ADR 0146).
    classes: Kernel::classes(...),
    packages: Kernel::packages(...),
    buildStore: Kernel::buildStore(...),
    database: Kernel::databasePath(...),
    migrations: App\Database\Migrations::PATH,
    // tinvar/codegen is a dev dependency: a production install has none.
    codegen: class_exists(CodegenCommand::class)
        ? static fn (array $arguments): int => CodegenCommand::of(APP_ROOT . '/resources/types', Kernel::classes(), Kernel::panels())->run($arguments)
        : null,
    // The app's public API -- whatever it marks #[RequiresScope] -- as an
    // OpenAPI 3.1 document, which `build` writes into dist/ when there is one
    // (ADR 0159). A dev dependency's too.
    openapi: class_exists(OpenApiCommand::class)
        ? static fn (array $arguments): int => OpenApiCommand::of(Kernel::NAME . ' API', Kernel::classes())->run($arguments)
        : null,
    // make:resource's test is tinvar/testing's, a dev dependency too.
    resourceTest: class_exists(ResourceTestSource::class) ? ResourceTestSource::of(...) : null,
    // Discovery reads the classes under the Kernel's namespace, and
    // `discover`, `build` and `check` its manifest in dist/. make:page,
    // make:query, make:action and make:model write classes it finds, and a
    // page's view into resources/entries/rsc.tsx.
    kernel: Kernel::class,
    // `serve` writes the renderers' lines into the app's log as well.
    rendererLog: Kernel::rendererLog(...),
    // `serve --worker` and `dev --worker` -- as bin/serve and bin/dev run
    // them -- run this CLI's queue:work beside the server: the account
    // emails go out through it.
    workers: true,
    // The migrations, and `doctor`, open the database the app does: the
    // SQLite file, made by `migrate` where it is missing, or the Postgres or
    // MySQL server APP_DATABASE_DRIVER names.
    connect: static fn (bool $create): Connection => $create || Kernel::config()->databaseDriver->isServer() || is_file(Kernel::databasePath())
        ? Kernel::connection($create)
        : throw new MigrationRefused('No database at ' . Kernel::databasePath() . '; `bin/tinvar migrate` makes one.'),
    // What `db:seed` fills the database with: a welcome note, where it has none.
    seeder: new App\Database\Seeders\WelcomeNote(),
    // Where `key:generate` and `doctor` find the key and the probe token.
    keyFile: Kernel::keyFile(...),
    probeTokenFile: Kernel::probeTokenFile(...),
);

// The queue's commands, over the app's Kernel (its `console`): queue:work
// sends the account emails (ADR 0153), and the rest look after it.
foreach ([
    'queue:work' => ['queue:work [--queue=mail,default] [--sleep=S] [--max-jobs=N] [--max-time=S] [--memory=MB] [--timeout=S] [--stop-budget=S] [--stop-when-empty]', "Run the app's queued jobs -- its email among them -- until stopped"],
    'queue:failed' => ['queue:failed', 'Every job that failed for good, and why'],
    'queue:retry' => ['queue:retry <id>... | all', 'Put failed jobs back on their queues'],
    'queue:hand-back' => ['queue:hand-back <file>', 'Put back the job a worker killed at a stop held (serve runs it)'],
] as $name => [$usage, $about]) {
    $console->command($name, $usage, $about, static fn (array $arguments): int => queue($name, $arguments));
}

exit($console
    // Who may frame a page: the document policy must say.
    ->withCheck('Content-Security-Policy failed:', static fn (): array => ContentSecurityPolicyRules::check(Kernel::contentSecurityPolicy('check')), "ok: the document policy says who may frame a page")
    // The asset route: the hashed names a build writes alone (ADR 0108).
    ->withCheck('Asset route failed:', static fn (): array => AssetRouteRules::check(APP_ROOT . '/Caddyfile'), "ok: Caddyfile's asset route serves only the names a build writes")
    // The public keys node agents and a console edge verify with (ADR 0119).
    ->withGatewayKeys(Kernel::appKey(...))
    ->command('setup', 'setup [--no-next-steps]', 'What composer create-project runs once: the app key and probe token, codegen, the database, and npm ci with no install scripts, from a lock tinvar check passes; `tinvar new` runs it with --no-next-steps, and says them itself', static fn (array $arguments): int => setup($console, !in_array('--no-next-steps', $arguments, true)))
    ->command('render', 'render --dump PATH [--build=DIR | --dev] [--part=html|payload] [--json]', 'Render one page through the real renderers on a copy of the database, and print its HTML and RSC payload with cookies and tokens cut out. Only where TINVAR_ENV is local, development or testing, through a build made with --profile=test (dist-test/), or with --dev through the running `tinvar dev`', static fn (array $arguments): int => devTools('render', $arguments))
    ->command('probe:token', 'probe:token', "Print the token /_health, /_ready and /_metrics take under this environment's profile: bound to it, so under staging not the one TINVAR_PROBE_TOKEN holds", static function (array $arguments): int {
        echo Kernel::probeToken(), "\n";

        return 0;
    })
    ->command('mcp', 'mcp [--build=DIR | --dev]', "A Model Context Protocol server on standard input and output: the app's routes, queries, actions, models and settings (never a value), the end of its log, and render --dump. Reads only", static fn (array $arguments): int => devTools('mcp', $arguments))
    ->run($argv));

/**
 * One of the queue's commands, through the app's Kernel. queue:work draws
 * email with the renderers: the pool `serve` and `dev` name in
 * TINVAR_SOCKET, or -- run on its own -- one started here from the build.
 *
 * @param list<string> $arguments
 */
function queue(string $command, array $arguments): int
{
    $renderer = null;
    $socket = getenv('TINVAR_SOCKET');
    if ($command === 'queue:work' && (!\is_string($socket) || $socket === '' || !file_exists($socket))) {
        try {
            $renderer = Tinvar\Server\RendererProcess::start(APP_ROOT, Kernel::buildDirectory() . '/rsc/index.js');
        } catch (RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . "\nBuild the app first (npm run build), or run the queue through bin/serve or bin/dev, which start their own renderers.\n");

            return 1;
        }
        $socket = $renderer->socketPath;
    }

    try {
        return Kernel::fromEnvironment(\is_string($socket) && $socket !== '' ? $socket : null)->console->run($command, $arguments);
    } finally {
        $renderer?->stop();
    }
}

/**
 * Once, after composer create-project has installed the app: the key and
 * the probe token, the generated TypeScript, the database, then npm ci --
 * from package-lock.json alone, every package held to its sha512, with no
 * package's install script run. It runs nothing it fetched: codegen and the
 * migrations are this app's own code and the framework's, which Composer
 * installed.
 *
 * And it installs nothing from a lock the supply-chain check refuses.
 * @tinvar/react and @tinvar/renderer are not on npm's registry yet, where
 * anyone may publish under their names; until they are, the check refuses
 * a lock that would fetch them from there (ADR 0138), and setup says how to
 * install them from their tarballs instead.
 */
function setup(AppConsole $console, bool $nextSteps = true): int
{
    $root = realpath(APP_ROOT) ?: APP_ROOT;

    try {
        Kernel::appKey();
        Kernel::probeToken();
    } catch (RuntimeException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");

        return 1;
    }
    // Where each is, never what it is.
    $file = getenv('TINVAR_APP_KEY') ? 'TINVAR_APP_KEY' : Kernel::keyFile();
    echo "app key: {$file}\n";
    $probe = getenv('TINVAR_PROBE_TOKEN') ? 'TINVAR_PROBE_TOKEN' : Kernel::probeTokenFile();
    echo "probe token: {$probe}\n";

    if ($console->run([__FILE__, 'codegen']) !== 0) {
        return 1;
    }
    // A server database that is not there yet -- Postgres or MySQL, before
    // its user and database are made -- does not stop the rest: npm still
    // installs, and the next steps say to migrate once it is there.
    $migrated = $console->migrate('migrate', []) === 0;
    if (!$migrated) {
        fwrite(STDERR, "\nThe database is not ready, so nothing was migrated: create it, then run `bin/tinvar migrate`; `bin/tinvar doctor` says what it cannot reach.\n");
    }

    $npm = null;
    foreach (explode(PATH_SEPARATOR, (string) getenv('PATH')) as $directory) {
        if ($directory !== '' && is_file("{$directory}/npm") && is_executable("{$directory}/npm")) {
            $npm = "{$directory}/npm";

            break;
        }
    }
    $installed = false;
    $refused = [];
    if ($npm !== null && getenv('TINVAR_SETUP_SKIP_NPM') !== '1') {
        $refused = new SupplyChain($root, Kernel::packages())->check();
        if ($refused !== []) {
            fwrite(STDERR, "\nnpm ci was not run: tinvar check refuses what it would install.\n  " . implode("\n  ", $refused) . "\n");
        } else {
            echo "\$ npm ci --ignore-scripts --no-audit --no-fund\n";
            $process = proc_open([$npm, 'ci', '--ignore-scripts', '--no-audit', '--no-fund'], [STDIN, STDOUT, STDERR], $pipes, $root);
            $installed = \is_resource($process) && proc_close($process) === 0;
            if (!$installed) {
                fwrite(STDERR, "npm ci failed; run it again in {$root}.\n");
            }
        }
    }

    // FrankenPHP, which bin/serve and bin/dev run: where none is found, the
    // release's binary for this machine, held to its pinned sha256 before it
    // is made executable (ADR 0175). Without one -- offline, or a machine
    // FrankenPHP publishes no binary for -- the next steps say how.
    $frankenphp = getenv('TINVAR_SETUP_SKIP_FRANKENPHP') === '1' || $console->run([__FILE__, 'frankenphp:install']) === 0;

    if (!$nextSteps) {
        return $migrated ? 0 : 1;
    }
    $cd = escapeshellarg(basename($root));
    echo "\nThe app is ready. Next:\n\n";
    echo "  cd {$cd}\n";
    if (!$installed && array_filter($refused, static fn (string $line): bool => str_contains($line, 'PackagePolicy::$unpublished')) !== []) {
        echo "  # @tinvar/react and @tinvar/renderer are not on npm yet: npm pack each\n";
        echo "  # (packages/react, packages/renderer of the framework's repository) into\n";
        echo "  # .packages/, depend on them in package.json as file:.packages/<tarball>,\n";
        echo "  npm install --ignore-scripts        # then this, which locks them; Node 22.13 or later\n";
        echo "  bin/tinvar check\n";
    } elseif (!$installed) {
        echo "  npm ci --ignore-scripts             # Node 22.13 or later\n";
    }
    if (!$migrated) {
        echo "  bin/tinvar migrate                  # once the database is there\n";
    }
    if (!$frankenphp) {
        echo "  bin/tinvar frankenphp:install       # FrankenPHP, which bin/serve and bin/dev run\n";
    }
    echo "  bin/tinvar doctor                   # every check the app needs, each problem with its fix\n";
    echo "  bin/dev                             # dev mode: renders from source, reloads as you edit\n";
    echo "  npm run build && bin/serve          # or the build, as production serves it\n";
    echo "  vendor/bin/pest && npx vitest run   # the tests\n\n";
    echo "Both serve with FrankenPHP: tools/frankenphp, unless TINVAR_FRANKENPHP or the PATH names another.\n";

    return $migrated ? 0 : 1;
}

/**
 * `render --dump` and `mcp`, tinvar/testing's development tools: refused
 * outside a developer's machine, rendering on a copy of the database --
 * the SQLite file, or the Postgres or MySQL database APP_DATABASE_DRIVER
 * names, copied on its own server (ADR 0173) -- through renderers started
 * on a build made for the test profile, by a Kernel with a key of its own.
 *
 * @param list<string> $arguments
 */
function devTools(string $command, array $arguments): int
{
    if (!class_exists(Tinvar\Testing\Dev\DevToolsCommand::class)) {
        fwrite(STDERR, "tinvar {$command} is tinvar/testing's, which is not installed: it is a development tool.\n");

        return 1;
    }

    try {
        // Where they may run, first: nothing of the database is read, not
        // even how to reach it, where they may not.
        Tinvar\Testing\Dev\DevTools::assertAllowed($command === 'mcp' ? 'tinvar mcp' : 'tinvar render --dump');
        // The app's own database: on a server, never the path the files
        // beside it are named from, which holds none of its rows.
        $database = Kernel::devToolsDatabase();
    } catch (RuntimeException|InvalidArgumentException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");

        return 1;
    }

    $routes = new RouteRegistry();
    $routes->registerAll(Kernel::classes()->routes);
    $root = realpath(APP_ROOT) ?: APP_ROOT;
    $tools = new Tinvar\Testing\Dev\DevToolsCommand(
        app: $root,
        projectRoot: $root,
        database: $database,
        // Through `tinvar dev` (--dev), $dev is the deferred manifest its dev
        // server keeps, and the Kernel is built in dev mode, as dev's is.
        // $database is the copy -- an SQLite file, or on a server its DSN,
        // password and all -- and $files where what the app keeps beside its
        // database goes: beside the copy, in its private directory.
        application: static function (string $socket, #[\SensitiveParameter] string $database, #[\SensitiveParameter] string $key, ?string $build, ?string $dev = null, ?string $files = null) use ($routes): Kernel {
            $deferred = $dev ?? "{$build}/rsc/deferred.json";

            return Kernel::fromEnvironment(
                $socket,
                key: $key,
                database: $database,
                manifest: ($build !== null || $dev !== null) && is_file($deferred) ? FragmentManifestProducer::produce($routes, $deferred) : new Tinvar\Render\FragmentManifest(),
                dev: $dev !== null,
                files: $files,
            );
        },
        models: Kernel::classes()->models,
        configs: Kernel::classes()->configs,
        log: Kernel::config()->log ?? Kernel::databasePath() . '-app.log',
    );

    return $command === 'mcp' ? $tools->mcp($arguments) : $tools->render($arguments);
}
