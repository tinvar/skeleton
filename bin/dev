#!/bin/sh
# Dev mode: Vite's dev server renders the app from source and swaps in what
# you edit, codegen runs again whenever app/ changes, and the dev toolbar
# sits over each page. Loopback only, and refused wherever TINVAR_ENV,
# APP_ENV or NODE_ENV says production.
#
#   bin/dev [--host=HOST] [--port=PORT] [--frankenphp=PATH]
set -eu

app=$(cd "$(dirname "$0")/.." && pwd)

php "$app/bin/tinvar" migrate >&2
# With the queue worker beside it: the account emails go out through it,
# into the mail log (database/app.sqlite-mail.log) unless a provider is named.
exec php "$app/bin/tinvar" dev --worker "$@"
