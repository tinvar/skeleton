# What the app reads from its environment, with nothing secret filled in.
#
# Copy it to .env (which git ignores) and fill in what you need. Docker
# Compose reads a .env beside compose.yaml for the variables compose.yaml
# names. bin/tinvar reads it too, on a developer's machine alone, never over
# the environment and never a variable whose name ends in _KEY, _SECRET,
# _PASSWORD, _TOKEN or _DSN (`bin/tinvar doctor` warns of each it finds):
# give bin/tinvar a secret in a file outside the project, named in its _FILE
# variable. On a server, set these in the environment it starts in. Never
# commit a key or a token.

# No secret goes here. On this machine, bin/serve and bin/dev generate the
# app key and the probe token into this user's state directory the first
# time (bin/tinvar setup prints where), outside the project. compose.yaml
# reads the app key, the probe token and the proxy secret from files in
# secrets/ instead -- its header shows the commands that make them -- and
# refuses to start without each.

# The https origin the app is served on, as https://app.example: every
# account email's link is built on it -- never on a request's Host -- and
# passkeys are made for its host. Required in production; in development
# the address bin/dev serves on stands in.
APP_URL=

# The address the app's email comes from. Required in production.
APP_MAIL_FROM=

# Who may open the admin panel at /admin: account addresses, comma-separated,
# as ada@example.com,grace@example.com. Unset, nobody may -- except under
# bin/dev, which lets every signed-in account in.
APP_ADMINS=

# The provider compose.yaml hands TINVAR_MAIL_PROVIDER: see below.
APP_MAIL_PROVIDER=

# The SQLite database; database/app.sqlite unless set.
# APP_DATABASE=

# JSON log lines; a file beside the database unless set.
# APP_LOG=

# Where the app keeps uploaded files, when it keeps them on local disk: the
# Caddyfile has its file server send them from here, rather than a worker.
# APP_STORAGE=

# Where mail goes: smtp, ses, postmark, mailgun, resend or sendgrid -- or
# several, comma-separated, tried in that order. Each reads its own
# variables, and every key may come from a file: TINVAR_SES_SECRET_FILE.
# Unset in development, mail goes to a file beside the database
# (APP_MAIL_LOG names another); in production it must be set. Never put a
# key in a URL.
# TINVAR_MAIL_PROVIDER=smtp
# TINVAR_SMTP_HOST=
# TINVAR_SMTP_PORT=587
# TINVAR_SMTP_USERNAME=
# TINVAR_SMTP_PASSWORD=
# TINVAR_SES_REGION=
# TINVAR_SES_KEY=
# TINVAR_SES_SECRET=
# TINVAR_POSTMARK_TOKEN=
# TINVAR_MAILGUN_KEY=
# TINVAR_MAILGUN_DOMAIN=
# TINVAR_MAILGUN_REGION=us
# TINVAR_RESEND_KEY=
# TINVAR_SENDGRID_KEY=
# The providers' webhooks, at /_mail/events/<provider>: each one's secret.
# TINVAR_RESEND_WEBHOOK_SECRET=
# TINVAR_SES_WEBHOOK_TOPICS=
# TINVAR_MAILGUN_WEBHOOK_SECRET=
# TINVAR_SENDGRID_WEBHOOK_PUBLIC_KEY=

# Throttle limits over the framework's defaults, as bucket=limit pairs.
# TINVAR_THROTTLE=actions=60

# FrankenPHP's binary, when it is not at tools/frankenphp or on the PATH.
# TINVAR_FRANKENPHP=
