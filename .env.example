# What the app reads from its environment, with nothing secret filled in.
#
# Nothing in the app reads this file. Docker Compose reads a .env beside
# compose.yaml for the variables compose.yaml names; anywhere else, set
# these in the environment the server starts in. Copy it to .env (which git
# ignores) and fill in what you need. Never commit a key or a token.

# The app key, 32 bytes or more: `openssl rand -base64 32`. Unset, bin/serve
# and bin/dev generate one into this user's state directory the first time
# (bin/tinvar setup prints where), outside the project. compose.yaml refuses
# to start without one.
APP_KEY=

# The only way into /_health, /_ready and /_metrics, 32 characters or more:
# `openssl rand -hex 24`, sent as `Authorization: Bearer <token>`. No caller
# is let in for its address, loopback included, unless
# TINVAR_PROBE_TRUST_LOOPBACK=1. Unset, bin/serve and bin/dev use the one
# `bin/tinvar setup` generated beside the app key (it prints where);
# compose.yaml refuses to start without one.
APP_PROBE_TOKEN=

# The SQLite database; database/app.sqlite unless set.
# APP_DATABASE=

# JSON log lines; a file beside the database unless set.
# APP_LOG=

# Where the app keeps uploaded files, when it keeps them on local disk: the
# Caddyfile has its file server send them from here, rather than a worker.
# APP_STORAGE=

# Throttle limits over the framework's defaults, as bucket=limit pairs.
# TINVAR_THROTTLE=actions=60

# FrankenPHP's binary, when it is not at tools/frankenphp or on the PATH.
# TINVAR_FRANKENPHP=
